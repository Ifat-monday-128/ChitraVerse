PORT=5000
# On Render, use the Supabase Session pooler URL (port 5432) with SSL required.
# DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:5432/postgres?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=chitraverse
DB_SSL=false
# Five connections is a conservative starting point for one Render instance.
DB_POOL_MAX=5
JWT_SECRET=replace_with_at_least_32_random_bytes
TMDB_TOKEN=your_tmdb_bearer_token
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Watch-provider region used when importing TMDB titles
TMDB_WATCH_REGION=BD
